{
  "name": "sistem-pelanggaran",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "server": "tsx watch server/src/index.ts",
    "dev:all": "concurrently -k -n \"SERVER,CLIENT\" -c \"cyan,blue\" \"tsx watch server/src/index.ts\" \"vite\"",
    "build:server": "esbuild server/src/app.ts --bundle --platform=node --format=esm --packages=external --outfile=api/index.js",
    "build": "tsc -b && vite build && npm run build:server",
    "lint": "oxlint",
    "preview": "vite preview"
  },
  "dependencies": {
    "@neondatabase/serverless": "^1.1.0",
    "@types/canvas-confetti": "^1.9.0",
    "@types/sql.js": "^1.4.11",
    "@vercel/blob": "^2.8.0",
    "canvas-confetti": "^1.9.4",
    "cors": "^2.8.6",
    "express": "^5.2.1",
    "jspdf": "^4.2.1",
    "jspdf-autotable": "^5.0.8",
    "lucide-react": "^1.43.0",
    "react": "^19.2.8",
    "react-dom": "^19.2.8",
    "sql.js": "^1.14.2",
    "xlsx": "^0.18.5"
  },
  "devDependencies": {
    "@types/cors": "^2.8.19",
    "@types/express": "^5.0.6",
    "@types/node": "^24.13.3",
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.2.4",
    "@vitejs/plugin-react": "^6.1.0",
    "autoprefixer": "^10.5.5",
    "concurrently": "^9.2.4",
    "esbuild": "^0.28.2",
    "oxlint": "^1.79.0",
    "postcss": "^8.5.28",
    "tailwindcss": "^3.4.17",
    "tsx": "^4.23.13",
    "typescript": "~6.0.2",
    "vite": "^8.2.2"
  },
  "allowScripts": {
    "core-js": true,
    "esbuild": true
  }
}
